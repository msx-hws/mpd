# External host port for Docker Compose or proxy configuration.
# The app listens on port 5001 inside the container and that port is fixed.
HOST_PORT=80

# Host's LAN IPv4 address, needed when running in Docker Desktop.
# Example: HOST_IP=192.168.1.42
HOST_IP=

# Debug options for local testing only.
# These do not change the internal listen port.
DEBUG=0

# Optional: enable Flask development mode only for local testing.
# Do not use in production.
FLASK_ENV=production
